{
  "description": "Retrieve cited destination excerpts; no embeddings or coordinates.",
  "input_schema": {
    "additionalProperties": false,
    "properties": {
      "city": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "City"
      },
      "country": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Country"
      },
      "k": {
        "default": 5,
        "maximum": 20,
        "minimum": 1,
        "title": "K",
        "type": "integer"
      },
      "query": {
        "maxLength": 1000,
        "minLength": 1,
        "title": "Query",
        "type": "string"
      },
      "season": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Season"
      },
      "topic": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Topic"
      }
    },
    "required": [
      "query"
    ],
    "title": "DestinationInput",
    "type": "object"
  },
  "name": "search_destinations",
  "output_schema": {
    "$defs": {
      "Chunk": {
        "additionalProperties": false,
        "properties": {
          "attribution": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Attribution"
          },
          "chunk_id": {
            "title": "Chunk Id",
            "type": "string"
          },
          "excerpt": {
            "maxLength": 600,
            "title": "Excerpt",
            "type": "string"
          },
          "license": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "License"
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          },
          "url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Url"
          }
        },
        "required": [
          "chunk_id",
          "title",
          "url",
          "license",
          "attribution",
          "excerpt"
        ],
        "title": "Chunk",
        "type": "object"
      },
      "DestinationOutput": {
        "additionalProperties": false,
        "properties": {
          "chunks": {
            "items": {
              "$ref": "#/$defs/Chunk"
            },
            "title": "Chunks",
            "type": "array"
          }
        },
        "required": [
          "chunks"
        ],
        "title": "DestinationOutput",
        "type": "object"
      },
      "Failure": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "$ref": "#/$defs/ToolError"
          }
        },
        "required": [
          "error"
        ],
        "title": "Failure",
        "type": "object"
      },
      "ToolError": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "enum": [
              "invalid_input",
              "timeout",
              "upstream_error",
              "output_too_large",
              "configuration",
              "internal_error"
            ],
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "retryable": {
            "default": false,
            "title": "Retryable",
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ToolError",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "cache_hit": {
        "title": "Cache Hit",
        "type": "boolean"
      },
      "data": {
        "anyOf": [
          {
            "$ref": "#/$defs/DestinationOutput"
          },
          {
            "$ref": "#/$defs/Failure"
          },
          {
            "type": "null"
          }
        ],
        "title": "Data"
      },
      "fetched_at": {
        "format": "date-time",
        "title": "Fetched At",
        "type": "string"
      },
      "source": {
        "title": "Source",
        "type": "string"
      },
      "status": {
        "enum": [
          "ok",
          "no_data",
          "error"
        ],
        "title": "Status",
        "type": "string"
      },
      "tool": {
        "title": "Tool",
        "type": "string"
      },
      "tool_result_id": {
        "title": "Tool Result Id",
        "type": "string"
      }
    },
    "required": [
      "tool_result_id",
      "tool",
      "status",
      "data",
      "source",
      "fetched_at",
      "cache_hit"
    ],
    "title": "ToolResult[DestinationOutput]",
    "type": "object"
  },
  "policy": {
    "attempts": 1,
    "cache_ttl_seconds": 0,
    "max_output_bytes": 65536,
    "timeout_seconds": 120
  }
}
