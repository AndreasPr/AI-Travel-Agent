{
  "description": "Validate local-time itinerary structure, schedule, budget and stored ToolResult price/coordinate evidence.",
  "input_schema": {
    "additionalProperties": false,
    "properties": {
      "budget": {
        "anyOf": [
          {
            "minimum": 0.0,
            "type": "number"
          },
          {
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "type": "string"
          }
        ],
        "title": "Budget"
      },
      "itinerary": {
        "additionalProperties": true,
        "title": "Itinerary",
        "type": "object"
      }
    },
    "required": [
      "itinerary",
      "budget"
    ],
    "title": "ValidateInput",
    "type": "object"
  },
  "name": "validate_itinerary",
  "output_schema": {
    "$defs": {
      "Failure": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "$ref": "#/$defs/ToolError"
          }
        },
        "required": [
          "error"
        ],
        "title": "Failure",
        "type": "object"
      },
      "Issue": {
        "additionalProperties": false,
        "properties": {
          "item_ids": {
            "items": {
              "type": "string"
            },
            "title": "Item Ids",
            "type": "array"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "severity": {
            "enum": [
              "error",
              "warning"
            ],
            "title": "Severity",
            "type": "string"
          }
        },
        "required": [
          "name",
          "severity",
          "message"
        ],
        "title": "Issue",
        "type": "object"
      },
      "ToolError": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "enum": [
              "invalid_input",
              "timeout",
              "upstream_error",
              "output_too_large",
              "configuration",
              "internal_error"
            ],
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "retryable": {
            "default": false,
            "title": "Retryable",
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ToolError",
        "type": "object"
      },
      "ValidateOutput": {
        "additionalProperties": false,
        "properties": {
          "currency": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Currency"
          },
          "issues": {
            "items": {
              "$ref": "#/$defs/Issue"
            },
            "title": "Issues",
            "type": "array"
          },
          "total_cost": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Total Cost"
          },
          "valid": {
            "title": "Valid",
            "type": "boolean"
          }
        },
        "required": [
          "valid",
          "total_cost",
          "currency",
          "issues"
        ],
        "title": "ValidateOutput",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "cache_hit": {
        "title": "Cache Hit",
        "type": "boolean"
      },
      "data": {
        "anyOf": [
          {
            "$ref": "#/$defs/ValidateOutput"
          },
          {
            "$ref": "#/$defs/Failure"
          },
          {
            "type": "null"
          }
        ],
        "title": "Data"
      },
      "fetched_at": {
        "format": "date-time",
        "title": "Fetched At",
        "type": "string"
      },
      "source": {
        "title": "Source",
        "type": "string"
      },
      "status": {
        "enum": [
          "ok",
          "no_data",
          "error"
        ],
        "title": "Status",
        "type": "string"
      },
      "tool": {
        "title": "Tool",
        "type": "string"
      },
      "tool_result_id": {
        "title": "Tool Result Id",
        "type": "string"
      }
    },
    "required": [
      "tool_result_id",
      "tool",
      "status",
      "data",
      "source",
      "fetched_at",
      "cache_hit"
    ],
    "title": "ToolResult[ValidateOutput]",
    "type": "object"
  },
  "policy": {
    "attempts": 1,
    "cache_ttl_seconds": 0,
    "max_output_bytes": 65536,
    "timeout_seconds": 10
  },
  "related_schemas": {
    "Itinerary": {
      "$defs": {
        "Coordinates": {
          "additionalProperties": false,
          "properties": {
            "lat": {
              "maximum": 90,
              "minimum": -90,
              "title": "Lat",
              "type": "number"
            },
            "lon": {
              "maximum": 180,
              "minimum": -180,
              "title": "Lon",
              "type": "number"
            }
          },
          "required": [
            "lat",
            "lon"
          ],
          "title": "Coordinates",
          "type": "object"
        },
        "Day": {
          "additionalProperties": false,
          "properties": {
            "date": {
              "format": "date",
              "title": "Date",
              "type": "string"
            },
            "items": {
              "items": {
                "$ref": "#/$defs/Item"
              },
              "title": "Items",
              "type": "array"
            }
          },
          "required": [
            "date",
            "items"
          ],
          "title": "Day",
          "type": "object"
        },
        "Item": {
          "additionalProperties": false,
          "properties": {
            "allow_outside_visiting_window": {
              "default": false,
              "title": "Allow Outside Visiting Window",
              "type": "boolean"
            },
            "category": {
              "title": "Category",
              "type": "string"
            },
            "chunk_ids": {
              "items": {
                "type": "string"
              },
              "title": "Chunk Ids",
              "type": "array"
            },
            "coord_tool_result_id": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Coord Tool Result Id"
            },
            "coords": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Coordinates"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "cost": {
              "anyOf": [
                {
                  "minimum": 0.0,
                  "type": "number"
                },
                {
                  "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Cost"
            },
            "currency": {
              "pattern": "^[A-Z]{3}$",
              "title": "Currency",
              "type": "string"
            },
            "end": {
              "format": "date-time",
              "title": "End",
              "type": "string"
            },
            "id": {
              "title": "Id",
              "type": "string"
            },
            "place": {
              "title": "Place",
              "type": "string"
            },
            "start": {
              "format": "date-time",
              "title": "Start",
              "type": "string"
            },
            "tool_result_ids": {
              "items": {
                "type": "string"
              },
              "title": "Tool Result Ids",
              "type": "array"
            },
            "travel_mode": {
              "default": "walking",
              "enum": [
                "walking",
                "transit"
              ],
              "title": "Travel Mode",
              "type": "string"
            }
          },
          "required": [
            "id",
            "start",
            "end",
            "place",
            "category",
            "currency"
          ],
          "title": "Item",
          "type": "object"
        },
        "Trip": {
          "additionalProperties": false,
          "properties": {
            "currency": {
              "pattern": "^[A-Z]{3}$",
              "title": "Currency",
              "type": "string"
            },
            "end_date": {
              "format": "date",
              "title": "End Date",
              "type": "string"
            },
            "start_date": {
              "format": "date",
              "title": "Start Date",
              "type": "string"
            }
          },
          "required": [
            "start_date",
            "end_date",
            "currency"
          ],
          "title": "Trip",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "days": {
          "items": {
            "$ref": "#/$defs/Day"
          },
          "title": "Days",
          "type": "array"
        },
        "trip": {
          "$ref": "#/$defs/Trip"
        }
      },
      "required": [
        "trip",
        "days"
      ],
      "title": "Itinerary",
      "type": "object"
    }
  }
}
