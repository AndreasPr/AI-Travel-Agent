{
  "description": "User-triggered OSM place lookup with attribution, caching and a shared-host one-request-per-second limit.",
  "input_schema": {
    "additionalProperties": false,
    "properties": {
      "city": {
        "maxLength": 200,
        "minLength": 1,
        "title": "City",
        "type": "string"
      },
      "name": {
        "maxLength": 200,
        "minLength": 1,
        "title": "Name",
        "type": "string"
      }
    },
    "required": [
      "name",
      "city"
    ],
    "title": "GeocodeInput",
    "type": "object"
  },
  "name": "geocode_place",
  "output_schema": {
    "$defs": {
      "Failure": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "$ref": "#/$defs/ToolError"
          }
        },
        "required": [
          "error"
        ],
        "title": "Failure",
        "type": "object"
      },
      "GeocodeOutput": {
        "additionalProperties": false,
        "properties": {
          "attribution": {
            "default": "\u00a9 OpenStreetMap contributors, ODbL 1.0. https://www.openstreetmap.org/copyright",
            "title": "Attribution",
            "type": "string"
          },
          "display_name": {
            "title": "Display Name",
            "type": "string"
          },
          "lat": {
            "maximum": 90,
            "minimum": -90,
            "title": "Lat",
            "type": "number"
          },
          "lon": {
            "maximum": 180,
            "minimum": -180,
            "title": "Lon",
            "type": "number"
          },
          "osm_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Osm Id"
          },
          "osm_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Osm Type"
          }
        },
        "required": [
          "lat",
          "lon",
          "display_name"
        ],
        "title": "GeocodeOutput",
        "type": "object"
      },
      "ToolError": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "enum": [
              "invalid_input",
              "timeout",
              "upstream_error",
              "output_too_large",
              "configuration",
              "internal_error"
            ],
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "retryable": {
            "default": false,
            "title": "Retryable",
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ToolError",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "cache_hit": {
        "title": "Cache Hit",
        "type": "boolean"
      },
      "data": {
        "anyOf": [
          {
            "$ref": "#/$defs/GeocodeOutput"
          },
          {
            "$ref": "#/$defs/Failure"
          },
          {
            "type": "null"
          }
        ],
        "title": "Data"
      },
      "fetched_at": {
        "format": "date-time",
        "title": "Fetched At",
        "type": "string"
      },
      "source": {
        "title": "Source",
        "type": "string"
      },
      "status": {
        "enum": [
          "ok",
          "no_data",
          "error"
        ],
        "title": "Status",
        "type": "string"
      },
      "tool": {
        "title": "Tool",
        "type": "string"
      },
      "tool_result_id": {
        "title": "Tool Result Id",
        "type": "string"
      }
    },
    "required": [
      "tool_result_id",
      "tool",
      "status",
      "data",
      "source",
      "fetched_at",
      "cache_hit"
    ],
    "title": "ToolResult[GeocodeOutput]",
    "type": "object"
  },
  "policy": {
    "attempts": 3,
    "cache_ttl_seconds": 2592000,
    "max_output_bytes": 65536,
    "timeout_seconds": 15
  }
}
