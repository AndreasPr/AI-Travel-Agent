{
  "description": "Search synthetic-v1 flights; max_price is a per-leg USD cap. Round trips require both legs to exist.",
  "input_schema": {
    "additionalProperties": false,
    "properties": {
      "depart_date": {
        "format": "date",
        "title": "Depart Date",
        "type": "string"
      },
      "destination_city": {
        "maxLength": 255,
        "minLength": 1,
        "title": "Destination City",
        "type": "string"
      },
      "max_price": {
        "anyOf": [
          {
            "minimum": 0.0,
            "type": "number"
          },
          {
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Max Price"
      },
      "origin": {
        "pattern": "^[A-Z]{3}$",
        "title": "Origin",
        "type": "string"
      },
      "return_date": {
        "anyOf": [
          {
            "format": "date",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Return Date"
      }
    },
    "required": [
      "origin",
      "destination_city",
      "depart_date"
    ],
    "title": "FlightsInput",
    "type": "object"
  },
  "name": "search_flights",
  "output_schema": {
    "$defs": {
      "Failure": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "$ref": "#/$defs/ToolError"
          }
        },
        "required": [
          "error"
        ],
        "title": "Failure",
        "type": "object"
      },
      "FlightQuote": {
        "additionalProperties": false,
        "properties": {
          "airline": {
            "title": "Airline",
            "type": "string"
          },
          "currency": {
            "title": "Currency",
            "type": "string"
          },
          "destination": {
            "title": "Destination",
            "type": "string"
          },
          "destination_city": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Destination City"
          },
          "duration_minutes": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Duration Minutes"
          },
          "flight_date": {
            "format": "date",
            "title": "Flight Date",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "is_nonstop": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Is Nonstop"
          },
          "origin": {
            "title": "Origin",
            "type": "string"
          },
          "origin_city": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Origin City"
          },
          "price": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              }
            ],
            "title": "Price"
          },
          "source": {
            "const": "synthetic-v1",
            "title": "Source",
            "type": "string"
          }
        },
        "required": [
          "id",
          "flight_date",
          "origin",
          "destination",
          "origin_city",
          "destination_city",
          "airline",
          "duration_minutes",
          "is_nonstop",
          "price",
          "currency",
          "source"
        ],
        "title": "FlightQuote",
        "type": "object"
      },
      "FlightsOutput": {
        "additionalProperties": false,
        "properties": {
          "availability": {
            "default": "Synthetic inventory only; not live availability or a booking offer.",
            "title": "Availability",
            "type": "string"
          },
          "inbound": {
            "items": {
              "$ref": "#/$defs/FlightQuote"
            },
            "title": "Inbound",
            "type": "array"
          },
          "outbound": {
            "items": {
              "$ref": "#/$defs/FlightQuote"
            },
            "title": "Outbound",
            "type": "array"
          },
          "truncated": {
            "default": false,
            "title": "Truncated",
            "type": "boolean"
          }
        },
        "required": [
          "outbound",
          "inbound"
        ],
        "title": "FlightsOutput",
        "type": "object"
      },
      "ToolError": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "enum": [
              "invalid_input",
              "timeout",
              "upstream_error",
              "output_too_large",
              "configuration",
              "internal_error"
            ],
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "retryable": {
            "default": false,
            "title": "Retryable",
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ToolError",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "cache_hit": {
        "title": "Cache Hit",
        "type": "boolean"
      },
      "data": {
        "anyOf": [
          {
            "$ref": "#/$defs/FlightsOutput"
          },
          {
            "$ref": "#/$defs/Failure"
          },
          {
            "type": "null"
          }
        ],
        "title": "Data"
      },
      "fetched_at": {
        "format": "date-time",
        "title": "Fetched At",
        "type": "string"
      },
      "source": {
        "title": "Source",
        "type": "string"
      },
      "status": {
        "enum": [
          "ok",
          "no_data",
          "error"
        ],
        "title": "Status",
        "type": "string"
      },
      "tool": {
        "title": "Tool",
        "type": "string"
      },
      "tool_result_id": {
        "title": "Tool Result Id",
        "type": "string"
      }
    },
    "required": [
      "tool_result_id",
      "tool",
      "status",
      "data",
      "source",
      "fetched_at",
      "cache_hit"
    ],
    "title": "ToolResult[FlightsOutput]",
    "type": "object"
  },
  "policy": {
    "attempts": 1,
    "cache_ttl_seconds": 0,
    "max_output_bytes": 65536,
    "timeout_seconds": 15
  }
}
