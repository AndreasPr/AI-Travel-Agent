{
  "description": "Convert using Frankfurter reference rates; returns the actual rate date.",
  "input_schema": {
    "additionalProperties": false,
    "properties": {
      "amount": {
        "anyOf": [
          {
            "minimum": 0.0,
            "type": "number"
          },
          {
            "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,12}|(?=[\\d.]{1,17}0*$)\\d{0,12}\\.\\d{0,4}0*$)",
            "type": "string"
          }
        ],
        "title": "Amount"
      },
      "date": {
        "anyOf": [
          {
            "format": "date",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Date"
      },
      "from": {
        "pattern": "^[A-Z]{3}$",
        "title": "From",
        "type": "string"
      },
      "to": {
        "pattern": "^[A-Z]{3}$",
        "title": "To",
        "type": "string"
      }
    },
    "required": [
      "amount",
      "from",
      "to"
    ],
    "title": "CurrencyInput",
    "type": "object"
  },
  "name": "convert_currency",
  "output_schema": {
    "$defs": {
      "CurrencyOutput": {
        "additionalProperties": false,
        "properties": {
          "amount": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              }
            ],
            "title": "Amount"
          },
          "converted_amount": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              }
            ],
            "title": "Converted Amount"
          },
          "from_currency": {
            "title": "From Currency",
            "type": "string"
          },
          "rate": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              }
            ],
            "title": "Rate"
          },
          "rate_date": {
            "format": "date",
            "title": "Rate Date",
            "type": "string"
          },
          "requested_date": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Requested Date"
          },
          "to_currency": {
            "title": "To Currency",
            "type": "string"
          }
        },
        "required": [
          "amount",
          "from_currency",
          "to_currency",
          "converted_amount",
          "rate",
          "rate_date",
          "requested_date"
        ],
        "title": "CurrencyOutput",
        "type": "object"
      },
      "Failure": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "$ref": "#/$defs/ToolError"
          }
        },
        "required": [
          "error"
        ],
        "title": "Failure",
        "type": "object"
      },
      "ToolError": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "enum": [
              "invalid_input",
              "timeout",
              "upstream_error",
              "output_too_large",
              "configuration",
              "internal_error"
            ],
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "retryable": {
            "default": false,
            "title": "Retryable",
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ToolError",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "cache_hit": {
        "title": "Cache Hit",
        "type": "boolean"
      },
      "data": {
        "anyOf": [
          {
            "$ref": "#/$defs/CurrencyOutput"
          },
          {
            "$ref": "#/$defs/Failure"
          },
          {
            "type": "null"
          }
        ],
        "title": "Data"
      },
      "fetched_at": {
        "format": "date-time",
        "title": "Fetched At",
        "type": "string"
      },
      "source": {
        "title": "Source",
        "type": "string"
      },
      "status": {
        "enum": [
          "ok",
          "no_data",
          "error"
        ],
        "title": "Status",
        "type": "string"
      },
      "tool": {
        "title": "Tool",
        "type": "string"
      },
      "tool_result_id": {
        "title": "Tool Result Id",
        "type": "string"
      }
    },
    "required": [
      "tool_result_id",
      "tool",
      "status",
      "data",
      "source",
      "fetched_at",
      "cache_hit"
    ],
    "title": "ToolResult[CurrencyOutput]",
    "type": "object"
  },
  "policy": {
    "attempts": 3,
    "cache_ttl_seconds": 86400,
    "max_output_bytes": 65536,
    "timeout_seconds": 15
  }
}
