{
  "$defs": {
    "Coordinates": {
      "additionalProperties": false,
      "properties": {
        "lat": {
          "maximum": 90,
          "minimum": -90,
          "title": "Lat",
          "type": "number"
        },
        "lon": {
          "maximum": 180,
          "minimum": -180,
          "title": "Lon",
          "type": "number"
        }
      },
      "required": [
        "lat",
        "lon"
      ],
      "title": "Coordinates",
      "type": "object"
    },
    "Day": {
      "additionalProperties": false,
      "properties": {
        "date": {
          "format": "date",
          "title": "Date",
          "type": "string"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/Item"
          },
          "title": "Items",
          "type": "array"
        }
      },
      "required": [
        "date",
        "items"
      ],
      "title": "Day",
      "type": "object"
    },
    "Item": {
      "additionalProperties": false,
      "properties": {
        "allow_outside_visiting_window": {
          "default": false,
          "title": "Allow Outside Visiting Window",
          "type": "boolean"
        },
        "category": {
          "title": "Category",
          "type": "string"
        },
        "chunk_ids": {
          "items": {
            "type": "string"
          },
          "title": "Chunk Ids",
          "type": "array"
        },
        "coord_tool_result_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Coord Tool Result Id"
        },
        "coords": {
          "anyOf": [
            {
              "$ref": "#/$defs/Coordinates"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "cost": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost"
        },
        "currency": {
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        },
        "end": {
          "format": "date-time",
          "title": "End",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "place": {
          "title": "Place",
          "type": "string"
        },
        "start": {
          "format": "date-time",
          "title": "Start",
          "type": "string"
        },
        "tool_result_ids": {
          "items": {
            "type": "string"
          },
          "title": "Tool Result Ids",
          "type": "array"
        },
        "travel_mode": {
          "default": "walking",
          "enum": [
            "walking",
            "transit"
          ],
          "title": "Travel Mode",
          "type": "string"
        }
      },
      "required": [
        "id",
        "start",
        "end",
        "place",
        "category",
        "currency"
      ],
      "title": "Item",
      "type": "object"
    },
    "Trip": {
      "additionalProperties": false,
      "properties": {
        "currency": {
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        },
        "end_date": {
          "format": "date",
          "title": "End Date",
          "type": "string"
        },
        "start_date": {
          "format": "date",
          "title": "Start Date",
          "type": "string"
        }
      },
      "required": [
        "start_date",
        "end_date",
        "currency"
      ],
      "title": "Trip",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "days": {
      "items": {
        "$ref": "#/$defs/Day"
      },
      "title": "Days",
      "type": "array"
    },
    "trip": {
      "$ref": "#/$defs/Trip"
    }
  },
  "required": [
    "trip",
    "days"
  ],
  "title": "Itinerary",
  "type": "object"
}
