{
  "$defs": {
    "Coordinates": {
      "additionalProperties": false,
      "properties": {
        "lat": {
          "maximum": 90,
          "minimum": -90,
          "title": "Lat",
          "type": "number"
        },
        "lon": {
          "maximum": 180,
          "minimum": -180,
          "title": "Lon",
          "type": "number"
        }
      },
      "required": [
        "lat",
        "lon"
      ],
      "title": "Coordinates",
      "type": "object"
    },
    "Day": {
      "additionalProperties": false,
      "properties": {
        "date": {
          "format": "date",
          "title": "Date",
          "type": "string"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/Item"
          },
          "title": "Items",
          "type": "array"
        }
      },
      "required": [
        "date",
        "items"
      ],
      "title": "Day",
      "type": "object"
    },
    "Item": {
      "additionalProperties": false,
      "properties": {
        "allow_outside_visiting_window": {
          "default": false,
          "title": "Allow Outside Visiting Window",
          "type": "boolean"
        },
        "category": {
          "title": "Category",
          "type": "string"
        },
        "chunk_ids": {
          "items": {
            "type": "string"
          },
          "title": "Chunk Ids",
          "type": "array"
        },
        "coord_tool_result_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Coord Tool Result Id"
        },
        "coords": {
          "anyOf": [
            {
              "$ref": "#/$defs/Coordinates"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "cost": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost"
        },
        "currency": {
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        },
        "end": {
          "format": "date-time",
          "title": "End",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "place": {
          "title": "Place",
          "type": "string"
        },
        "start": {
          "format": "date-time",
          "title": "Start",
          "type": "string"
        },
        "tool_result_ids": {
          "items": {
            "type": "string"
          },
          "title": "Tool Result Ids",
          "type": "array"
        },
        "travel_mode": {
          "default": "walking",
          "enum": [
            "walking",
            "transit"
          ],
          "title": "Travel Mode",
          "type": "string"
        }
      },
      "required": [
        "id",
        "start",
        "end",
        "place",
        "category",
        "currency"
      ],
      "title": "Item",
      "type": "object"
    },
    "Itinerary": {
      "additionalProperties": false,
      "properties": {
        "days": {
          "items": {
            "$ref": "#/$defs/Day"
          },
          "title": "Days",
          "type": "array"
        },
        "trip": {
          "$ref": "#/$defs/Trip"
        }
      },
      "required": [
        "trip",
        "days"
      ],
      "title": "Itinerary",
      "type": "object"
    },
    "Preferences": {
      "additionalProperties": false,
      "properties": {
        "budget": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Budget"
        },
        "dietary_needs": {
          "items": {
            "enum": [
              "vegetarian",
              "vegan",
              "halal",
              "kosher",
              "gluten-free"
            ],
            "type": "string"
          },
          "title": "Dietary Needs",
          "type": "array"
        },
        "interests": {
          "items": {
            "enum": [
              "museums",
              "food",
              "nature",
              "history",
              "art",
              "shopping",
              "beaches",
              "nightlife"
            ],
            "type": "string"
          },
          "title": "Interests",
          "type": "array"
        },
        "mobility": {
          "anyOf": [
            {
              "enum": [
                "standard",
                "step-free",
                "short-walks"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mobility"
        },
        "pace": {
          "anyOf": [
            {
              "enum": [
                "relaxed",
                "moderate",
                "busy"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pace"
        }
      },
      "title": "Preferences",
      "type": "object"
    },
    "Trip": {
      "additionalProperties": false,
      "properties": {
        "currency": {
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        },
        "end_date": {
          "format": "date",
          "title": "End Date",
          "type": "string"
        },
        "start_date": {
          "format": "date",
          "title": "Start Date",
          "type": "string"
        }
      },
      "required": [
        "start_date",
        "end_date",
        "currency"
      ],
      "title": "Trip",
      "type": "object"
    },
    "Usage": {
      "additionalProperties": false,
      "properties": {
        "cached_tokens": {
          "default": 0,
          "title": "Cached Tokens",
          "type": "integer"
        },
        "calls": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Calls",
          "type": "array"
        },
        "tokens_in": {
          "default": 0,
          "title": "Tokens In",
          "type": "integer"
        },
        "tokens_out": {
          "default": 0,
          "title": "Tokens Out",
          "type": "integer"
        },
        "uncached_tokens": {
          "default": 0,
          "title": "Uncached Tokens",
          "type": "integer"
        }
      },
      "title": "Usage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "budget_met": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Budget Met"
    },
    "citations": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Citations",
      "type": "array"
    },
    "diff": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Diff"
    },
    "issues": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Issues",
      "type": "array"
    },
    "itinerary": {
      "anyOf": [
        {
          "$ref": "#/$defs/Itinerary"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "message": {
      "title": "Message",
      "type": "string"
    },
    "preference_proposal": {
      "anyOf": [
        {
          "$ref": "#/$defs/Preferences"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "tool_trace": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Tool Trace",
      "type": "array"
    },
    "trip_id": {
      "title": "Trip Id",
      "type": "string"
    },
    "usage": {
      "$ref": "#/$defs/Usage"
    }
  },
  "required": [
    "trip_id",
    "message"
  ],
  "title": "ChatResponse",
  "type": "object"
}
